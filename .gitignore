.DS_Store

node_modules
dist
*.local
*.tsbuildinfo

# TanStack Router's temporary files. The route tree itself, apps/web/src/routeTree.gen.ts, is
# committed.
.tanstack/

.env
.env.*
!.env.example

# AI agent worktrees.
.claude/worktrees/

# The Vercel CLI link of this checkout (scripts/setup-services.sh).
.vercel

# The platform binaries of the Impeccable skill. Its launcher, scripts/impeccable, downloads the
# pinned version into ~/.impeccable on first use.
**/skills/impeccable/scripts/bin/

# The state of Impeccable live sessions. Only the config is committed.
**/.impeccable/live/*
!**/.impeccable/live/config.json
